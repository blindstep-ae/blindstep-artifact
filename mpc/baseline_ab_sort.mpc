"""
[DEPRECATED] BlindStep All-Boolean Baseline: Full Oblivious Sort
=================================================================
STATUS: Not in paper Section 6 comparison matrix.
REASON: Uses load_mock_candidates() instead of real module1_backend CPSI
        ingress. Module 1 is NOT shared with blindstep_full.mpc.
        For the fair all-boolean sort baseline (same Module 1), use:
          baseline_ab_batcher_sort.mpc

Domain    : All-Boolean / Yao GC (-B 64)
Selection : Bitonic Sort, full N_MAX
"""
from Compiler.GC.types import sbitint

# =============== Parameters (Frozen Spec) ===============
N_MAX = 128
K = 5
SCORE_BITS = 16

TIE_BITS = (N_MAX - 1).bit_length()
PACKED_BITS = 1 + SCORE_BITS + TIE_BITS

# Single type anchor for the all-Boolean domain
packed_t = sbitint.get_type(PACKED_BITS)

# --- Layout Offsets ---
TIE_SHIFT   = 0
SCORE_SHIFT = TIE_BITS
VALID_SHIFT = TIE_BITS + SCORE_BITS

MAX_TIE = (1 << TIE_BITS) - 1

def encode_tuple_clear(valid, score, tie):
    """Pure cleartext assembly; keeps MPC types out of the packing math."""
    inverted_tie = MAX_TIE - tie
    return valid * (1 << VALID_SHIFT) + score * (1 << SCORE_SHIFT) + inverted_tie

def load_mock_candidates():
    # Container type switched to packed_t
    inputs = Array(N_MAX, packed_t)
    
    # Force native Python unrolling: compute the cleartext integer first,
    # then load it into the GC type
    for i in range(N_MAX):
        is_match = 1 if (5 <= i <= 15) else 0
        s_A = is_match * (i * 2)
        s_B = is_match * (i * 3)
        s_tot = s_A + s_B
        
        # Pack in the clear, then move into the binary secret domain in one step
        raw_val = encode_tuple_clear(is_match, s_tot, i)
        inputs[i] = packed_t(raw_val)
        
    return inputs

def full_oblivious_sort(candidates):
    arr = Array(N_MAX, packed_t)
    for i in range(N_MAX):
        arr[i] = candidates[i]
        
    # Bitonic Sort O(N log^2 N) Comparator Network
    k_step = 2
    while k_step <= N_MAX:
        j_step = k_step // 2
        while j_step > 0:
            for i in range(N_MAX):
                ixj = i ^ j_step
                if ixj > i:
                    dir_desc = (i & k_step) == 0
                    
                    x = MemValue(arr[i])
                    y = MemValue(arr[ixj])
                    
                    if dir_desc:
                        should_swap = y.read() > x.read()
                    else:
                        should_swap = x.read() > y.read()
                        
                    new_x = should_swap.if_else(y.read(), x.read())
                    new_y = should_swap.if_else(x.read(), y.read())
                    
                    arr[i] = new_x
                    arr[ixj] = new_y
            j_step //= 2
        k_step *= 2
        
    top_k_arr = Array(K, packed_t)
    for m in range(K):
        top_k_arr[m] = arr[m]
    return top_k_arr

def main():
    print_ln("--- All-Boolean Sort Baseline ---")
    candidates = load_mock_candidates()
    top_k_handles = full_oblivious_sort(candidates)
    
    for i in range(K):
        # Never reveal the tie tag (paper 6.1). Shift out TIE_BITS in the Boolean
        # domain; reveal only the (valid || score) segment for outside parsing.
        vs_part = top_k_handles[i] >> TIE_BITS
        vs_clear = vs_part.reveal()
        print_ln("RAW_CSV,%s,%s", i, vs_clear)

main()
