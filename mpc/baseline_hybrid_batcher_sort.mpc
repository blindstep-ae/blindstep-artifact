"""
BlindStep Baseline: Hybrid Pipeline + Batcher's Odd-Even Merge Sort
====================================================================
Compile : ./compile.py -R 64 baseline_hybrid_batcher_sort
Run     : ./Scripts/semi2k.sh baseline_hybrid_batcher_sort

This baseline replaces the secure insertion queue (Module 2) with
Batcher's odd-even merge sort, a standard oblivious sorting network
with O(N log^2 N) compare-and-swap complexity.

The pipeline shares Module 1 with blindstep_full.mpc:
  Timer M1 — MPC Ingress + Aggregation              (real CPSI shares)
  Timer M2 — Score Composition + Packing            (arithmetic adds)
  Timer M3 — Module 2: Sort-then-truncate Top-K     (O(N log^2 N))

Note on MP-SPDZ sort() behavior:
  Array.sort(batcher=True) explicitly invokes loopy_odd_even_merge_sort,
  a pure compare-and-swap network with no reveal-based shortcuts.
  This is the correct oblivious baseline for comparison with the queue.
  Contrast: Array.sort() without batcher=True would use radix_sort under
  -R mode, which internally reveals a shuffled key order and does NOT
  satisfy the leakage profile of this paper.
"""
from Compiler.types import sint, Array, MemValue
from Compiler.library import for_range, print_ln, start_timer, stop_timer
import bs_core
import module1_backend

# =============== Parameters ===============
N_F = 256
N_E = 256
K = 5
SCORE_BITS = 16
M_MAX = 3         # CPSI slot budget per A-row; edit here to sweep (must match share file)

# --- Bit-width derivation ---
TIE_BITS, PACKED_BITS, SCORE_SHIFT, VALID_SHIFT, MAX_TIE = bs_core.get_tuple_shifts(N_F, SCORE_BITS)
assert PACKED_BITS < 64, f"Packed width {PACKED_BITS} exceeds safe ring margin"

# =============== Module 2: Batcher Sort + Truncate ===============

def secure_batcher_sort_topk(candidates, N, K):
    """
    Sort-then-truncate baseline using Batcher's odd-even merge sort.
    Complexity: O(N log^2 N) compare-and-swap operations.

    Array.sort(batcher=True) explicitly invokes loopy_odd_even_merge_sort,
    a pure compare-and-swap network with no reveal-based shortcuts.

    After ascending sort, the top-K slots are the last K elements.
    Packed tuple encoding ensures (valid=1, high_score, low_tie) sorts last.
    """
    table = Array(N, sint)
    @for_range(N)
    def _(i):
        table[i] = candidates[i]

    # Explicit Batcher sort — pure oblivious network, no reveal
    table.sort(batcher=True)

    # After ascending sort, top-K = last K elements (largest packed value first)
    top_k = Array(K, sint)
    @for_range(K)
    def _(i):
        top_k[i] = table[N - 1 - i]
    return top_k

# =============== Data Ingress (shared with blindstep_full) ===============

# A-side private input loading moved to module1_backend.load_private_inputs().
# =============== Main: 3-Phase Breakdown ===============

def main():
    print_ln("===== Baseline: Hybrid + Batcher Sort =====")
    print_ln("  N_F=%s  K=%s  b=%s", N_F, K, SCORE_BITS)

    A_scores, A_valid = module1_backend.load_private_inputs(N_F)

    # --- Timer M1: MPC Ingress + Aggregation ---
    print_ln("--- Timer M1: MPC Ingress + Aggregation ---")
    start_timer(1)
    # M_MAX is a top-level constant (see Parameters section above)
    cpsi_flags, cpsi_scores, overflow_flags = module1_backend.load_external_cpsi_shares(N_F, M_MAX)
    valid_flags, s_A_array, s_B_array = module1_backend.aggregation_layer(
        cpsi_flags, cpsi_scores, overflow_flags, A_scores, A_valid, N_F, M_MAX
    )
    stop_timer(1)

    # --- Timer M2: Score Composition + Packing ---
    print_ln("--- Timer M2: Score Composition + Packing ---")
    start_timer(2)
    total_scores = bs_core.compose_scores(valid_flags, s_A_array, s_B_array, N_F)
    candidate_table = bs_core.prepare_candidate_table(
        valid_flags, total_scores, N_F, VALID_SHIFT, SCORE_SHIFT, MAX_TIE
    )
    stop_timer(2)

    # --- Timer M3: Module 2 (Batcher Sort) ---
    print_ln("--- Timer M3: Module 2 (Batcher Sort) ---")
    start_timer(3)
    top_k_handles = secure_batcher_sort_topk(candidate_table, N_F, K)
    stop_timer(3)

    print_ln("\n--- Top-K Results ---")
    @for_range(K)
    def _(i):
        # Never reveal the tie tag (paper 6.1: "never reconstructed, excluded
        # from rho"). Right-shift out TIE_BITS in the secret domain and reveal
        # only the (valid || score) segment. Explicit bit-length => exact
        # truncation, not probabilistic.
        vs_part = top_k_handles[i].right_shift(TIE_BITS, PACKED_BITS)
        vs_clear = vs_part.reveal()
        valid = (vs_clear >> SCORE_BITS) & 1
        score = vs_clear & ((1 << SCORE_BITS) - 1)
        print_ln("TOPK_CSV,%s,%s,%s", i, valid, score)

    print_ln("===== Baseline Complete =====")

main()
